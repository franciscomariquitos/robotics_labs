<mujoco model="golfista">

    <!-- Comprimentos em metros, massas em kg.
         Ângulos geométricos e limites dos joints em graus.
         Os comandos dos atuadores de posição usam radianos. -->
    <compiler angle="degree"/>

    <!-- Gravidade vertical, passo de 1 ms e integrador adequado
         aos atuadores com amortecimento. -->
    <option gravity="0 0 -9.81"
            timestep="0.001"
            integrator="implicitfast"/>

    <worldbody>

        <!-- Iluminação da cena. -->
        <light pos="0 -3 4"/>

        <!-- Convenção:
             x = frente do jogador
             y = lado esquerdo do jogador
             z = cima -->

        <!-- Chão horizontal na altura z = 0. -->
        <geom name="chao"
              type="plane"
              size="4 4 0.1"
              rgba="0.75 0.80 0.75 1"/>

        <!-- PÉLVIS
             Origem a 95 cm do chão.
             Sem joint: fica fixa ao mundo.
             Os corpos dentro dela usam coordenadas relativas à pélvis. -->
        <body name="pelvis" pos="0 0 0.95">

            <!-- Nas caixas, size contém as semidimensões.
                 Dimensões totais: 24 x 32 x 18 cm.
                 As massas são estimativas iniciais. -->
            <geom name="pelvis_geom"
                  type="box"
                  size="0.12 0.16 0.09"
                  mass="10"
                  rgba="0.20 0.25 0.35 1"/>

            <!-- PERNA ESQUERDA
                 Sem articulações nesta primeira versão:
                 fica rigidamente ligada à pélvis. -->
            <body name="perna_esquerda" pos="0 0.13 -0.05">

                <!-- Coxa com 40 cm entre os pontos do eixo central. -->
                <geom name="coxa_esquerda"
                      type="capsule"
                      fromto="0 0 0 0 0 -0.40"
                      size="0.065"
                      mass="7"
                      rgba="0.25 0.30 0.45 1"/>

                <!-- Canela com 40 cm entre joelho e tornozelo. -->
                <geom name="canela_esquerda"
                      type="capsule"
                      fromto="0 0 -0.40 0 0 -0.80"
                      size="0.045"
                      mass="3.5"
                      rgba="0.35 0.40 0.55 1"/>

                <!-- Pé com 26 x 12 x 10 cm.
                     Centro a 5 cm do chão e sola na altura zero. -->
                <geom name="pe_esquerdo"
                      type="box"
                      pos="0.07 0 -0.85"
                      size="0.13 0.06 0.05"
                      mass="1"
                      rgba="0.15 0.15 0.15 1"/>
            </body>

            <!-- PERNA DIREITA
                 Simétrica à esquerda em relação ao plano y = 0. -->
            <body name="perna_direita" pos="0 -0.13 -0.05">

                <geom name="coxa_direita"
                      type="capsule"
                      fromto="0 0 0 0 0 -0.40"
                      size="0.065"
                      mass="7"
                      rgba="0.25 0.30 0.45 1"/>

                <geom name="canela_direita"
                      type="capsule"
                      fromto="0 0 -0.40 0 0 -0.80"
                      size="0.045"
                      mass="3.5"
                      rgba="0.35 0.40 0.55 1"/>

                <geom name="pe_direito"
                      type="box"
                      pos="0.07 0 -0.85"
                      size="0.13 0.06 0.05"
                      mass="1"
                      rgba="0.15 0.15 0.15 1"/>
            </body>

            <!-- TRONCO
                 Origem no topo da pélvis.
                 A cabeça e os braços acompanham o seu movimento. -->
            <body name="tronco" pos="0 0 0.09">

                <!-- Cintura: rotação em torno do eixo vertical.
                     Limites angulares em graus.
                     damping introduz resistência proporcional
                     à velocidade angular. -->
                <joint name="cintura_rotacao"
                       type="hinge"
                       pos="0 0 0"
                       axis="0 0 1"
                       limited="true"
                       range="-60 60"
                       damping="2"/>

                <!-- Tronco com dimensões totais de 24 x 40 x 44 cm. -->
                <geom name="tronco_geom"
                      type="box"
                      pos="0 0 0.22"
                      size="0.12 0.20 0.22"
                      mass="25"
                      rgba="0.15 0.55 0.80 1"/>

                <!-- Pescoço rigidamente ligado ao tronco. -->
                <geom name="pescoco"
                      type="capsule"
                      fromto="0 0 0.44 0 0 0.52"
                      size="0.045"
                      mass="0.5"
                      rgba="0.85 0.65 0.50 1"/>

                <!-- Cabeça também rigidamente ligada ao tronco. -->
                <geom name="cabeca"
                      type="sphere"
                      pos="0 0 0.61"
                      size="0.10"
                      mass="4.5"
                      rgba="0.85 0.65 0.50 1"/>

                <!-- Ombros visuais, com posições relativas ao TRONCO. -->
                <geom name="ombro_esquerdo_visual"
                      type="sphere"
                      pos="0 0.235 0.40"
                      size="0.065"
                      mass="0"
                      contype="0"
                      conaffinity="0"
                      rgba="0.15 0.55 0.80 1"/>

                <geom name="ombro_direito_visual"
                      type="sphere"
                      pos="0 -0.235 0.40"
                      size="0.065"
                      mass="0"
                      contype="0"
                      conaffinity="0"
                      rgba="0.15 0.55 0.80 1"/>

                <!-- BRAÇO ESQUERDO
                     Origem no ombro, relativa ao tronco. -->
                <body name="braco_esquerdo" pos="0 0.27 0.40">

                    <!-- Movimento para a frente/trás.
                         Na postura inicial, ângulos positivos
                         levantam o braço para a frente (+x). -->
                    <joint name="ombro_esquerdo_frente"
                           type="hinge"
                           axis="0 -1 0"
                           limited="true"
                           range="-60 160"
                           damping="1"/>

                    <!-- Movimento lateral.
                         Na postura inicial, ângulos positivos
                         afastam o braço para a esquerda (+y). -->
                    <joint name="ombro_esquerdo_lado"
                           type="hinge"
                           axis="1 0 0"
                           limited="true"
                           range="-20 160"
                           damping="1"/>

                    <!-- Braço com 30 cm entre ombro e cotovelo. -->
                    <geom name="braco_esquerdo_geom"
                          type="capsule"
                          fromto="0 0 0 0 0 -0.30"
                          size="0.045"
                          mass="3"
                          rgba="0.85 0.65 0.50 1"/>

                    <!-- ANTEBRAÇO ESQUERDO
                         Origem no cotovelo, relativa ao braço. -->
                    <body name="antebraco_esquerdo" pos="0 0 -0.30">

                        <!-- Zero: cotovelo esticado.
                             Ângulos positivos: flexão para a frente
                             quando o braço está na postura inicial. -->
                        <joint name="cotovelo_esquerdo"
                               type="hinge"
                               axis="0 -1 0"
                               limited="true"
                               range="0 140"
                               damping="0.5"/>

                        <!-- Antebraço com 26 cm entre cotovelo e pulso. -->
                        <geom name="antebraco_esquerdo_geom"
                              type="capsule"
                              fromto="0 0 0 0 0 -0.26"
                              size="0.035"
                              mass="1.5"
                              rgba="0.85 0.65 0.50 1"/>

                        <!-- Mão simplificada, ainda sem joint no pulso. -->
                        <geom name="mao_esquerda"
                              type="sphere"
                              pos="0 0 -0.30"
                              size="0.04"
                              mass="0.4"
                              rgba="0.85 0.65 0.50 1"/>
                    </body>
                </body>

                <!-- BRAÇO DIREITO
                     Origem no lado negativo de y do tronco. -->
                <body name="braco_direito" pos="0 -0.27 0.40">

                    <!-- Movimento para a frente/trás. -->
                    <joint name="ombro_direito_frente"
                           type="hinge"
                           axis="0 -1 0"
                           limited="true"
                           range="-60 160"
                           damping="1"/>

                    <!-- Eixo oposto ao do ombro esquerdo.
                         Ângulos positivos afastam o braço
                         para a direita na postura inicial. -->
                    <joint name="ombro_direito_lado"
                           type="hinge"
                           axis="-1 0 0"
                           limited="true"
                           range="-20 160"
                           damping="1"/>

                    <geom name="braco_direito_geom"
                          type="capsule"
                          fromto="0 0 0 0 0 -0.30"
                          size="0.045"
                          mass="3"
                          rgba="0.85 0.65 0.50 1"/>

                    <!-- ANTEBRAÇO DIREITO -->
                    <body name="antebraco_direito" pos="0 0 -0.30">

                        <joint name="cotovelo_direito"
                               type="hinge"
                               axis="0 -1 0"
                               limited="true"
                               range="0 140"
                               damping="0.5"/>

                        <geom name="antebraco_direito_geom"
                              type="capsule"
                              fromto="0 0 0 0 0 -0.26"
                              size="0.035"
                              mass="1.5"
                              rgba="0.85 0.65 0.50 1"/>

                        <!-- Mão rigidamente ligada ao antebraço. -->
                        <geom name="mao_direita"
                              type="sphere"
                              pos="0 0 -0.30"
                              size="0.04"
                              mass="0.4"
                              rgba="0.85 0.65 0.50 1"/>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- ATUADORES DE POSIÇÃO
         Cada atuador tenta atingir um ângulo desejado.

         Com gear=1:
         binário = kp * (ângulo desejado - ângulo atual)
                   - kv * velocidade angular
         sujeito aos limites definidos em forcerange.

         kp: ganho de posição, em N.m/rad.
         kv: ganho de amortecimento, em N.m.s/rad.
         ctrlrange: intervalo do comando, em RADIANOS.
         forcerange: intervalo de binário, em N.m.

         Ganhos e limites são valores iniciais para os testes,
         ainda não validados como parâmetros biomecânicos. -->
    <actuator>

        <!-- Cintura: aproximadamente -60 a +60 graus. -->
        <position name="motor_cintura"
                  joint="cintura_rotacao"
                  gear="1"
                  kp="500"
                  kv="50"
                  ctrllimited="true"
                  ctrlrange="-1.0472 1.0472"
                  forcelimited="true"
                  forcerange="-100 100"/>

        <!-- Ombro esquerdo: movimento para a frente/trás. -->
        <position name="motor_ombro_esq_frente"
                  joint="ombro_esquerdo_frente"
                  gear="1"
                  kp="300"
                  kv="30"
                  ctrllimited="true"
                  ctrlrange="-1.0472 2.7925"
                  forcelimited="true"
                  forcerange="-60 60"/>

        <!-- Ombro esquerdo: movimento lateral. -->
        <position name="motor_ombro_esq_lado"
                  joint="ombro_esquerdo_lado"
                  gear="1"
                  kp="300"
                  kv="30"
                  ctrllimited="true"
                  ctrlrange="-0.3491 2.7925"
                  forcelimited="true"
                  forcerange="-60 60"/>

        <!-- Cotovelo esquerdo: aproximadamente 0 a 140 graus. -->
        <position name="motor_cotovelo_esq"
                  joint="cotovelo_esquerdo"
                  gear="1"
                  kp="150"
                  kv="10"
                  ctrllimited="true"
                  ctrlrange="0 2.4435"
                  forcelimited="true"
                  forcerange="-30 30"/>

        <!-- Ombro direito: movimento para a frente/trás. -->
        <position name="motor_ombro_dir_frente"
                  joint="ombro_direito_frente"
                  gear="1"
                  kp="300"
                  kv="30"
                  ctrllimited="true"
                  ctrlrange="-1.0472 2.7925"
                  forcelimited="true"
                  forcerange="-60 60"/>

        <!-- Ombro direito: movimento lateral. -->
        <position name="motor_ombro_dir_lado"
                  joint="ombro_direito_lado"
                  gear="1"
                  kp="300"
                  kv="30"
                  ctrllimited="true"
                  ctrlrange="-0.3491 2.7925"
                  forcelimited="true"
                  forcerange="-60 60"/>

        <!-- Cotovelo direito. -->
        <position name="motor_cotovelo_dir"
                  joint="cotovelo_direito"
                  gear="1"
                  kp="150"
                  kv="10"
                  ctrllimited="true"
                  ctrlrange="0 2.4435"
                  forcelimited="true"
                  forcerange="-30 30"/>
    </actuator>

</mujoco>