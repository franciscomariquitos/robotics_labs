<?xml version='1.0' encoding='utf-8'?>
<mujoco model="golfista">
    <!-- SI: metros, kg, segundos. Angulos XML em graus; qpos e controlos em radianos. -->
    <compiler angle="degree" autolimits="true" />

    <!--integrator="implicitfast" é o algoritmo numérico usado pelo MuJoCo
     para avançar a dinâmica.-->
    <!--Quando existem contactos e restrições, o MuJoCo tem de resolver 
    numericamente essas restrições. Permitimos até 100 iterações-->
    <!--A tolerance é usada pelo solver para decidir quando uma solução está 
    suficientemente convergida-->
    <!-- O cone="elliptic" Controla o modelo de cone de atrito.-->
    <option timestep=".001" gravity="0 0 -9.81" integrator="implicitfast" iterations="100" tolerance="1e-10" cone="elliptic" />
    
    <statistic center="0.15 0 0.9" extent="2.4" />
    <visual>
        <global offwidth="1280" offheight="960" />
    </visual>
    <default>
        <joint damping="1" armature=".015" />
        <geom contype="0" conaffinity="0" rgba=".83 .64 .49 1" />
    </default>
    <worldbody>
        <light pos="1 -3 4" dir="-0.2 0.5 -1" />
        <light pos="-2 2 3" diffuse=".5 .5 .5" />
        <!-- x: frente do jogador; y: esquerda; z: cima. Geometrias humanas sem auto-colisao nesta fase. -->
        <geom name="chao" type="plane" size="4 4 .1" rgba=".45 .58 .43 1" contype="1" conaffinity="6" friction=".9 .01 .001" condim="6" solref=".01 1" />
        <body name="pelvis" pos="-.05 0 .90">
            <!-- Bacia livre: nao existe apoio invisivel nem fixacao ao mundo. -->
            <freejoint name="base_livre" />
            <geom name="pelvis_geom" type="ellipsoid" size=".12 .17 .10" mass="10" rgba=".2 .24 .33 1" />
            <!-- Perna esq: anca 3 eixos, joelho 1, tornozelo 2. Massas aproximadas. -->
            <body name="coxa_esq" pos="0 0.13 -.05">
                <joint name="anca_esq_yaw" type="hinge" axis="0 0 1" range="-50 50" />
                <joint name="anca_esq_roll" type="hinge" axis="1 0 0" range="-45 45" />
                <joint name="anca_esq_pitch" type="hinge" axis="0 1 0" range="-110 50" />
                <geom type="capsule" fromto="0 0 0 0 0 -.40" size=".06" mass="7" rgba=".23 .28 .40 1" />
                <body name="canela_esq" pos="0 0 -.40">
                    <joint name="joelho_esq" type="hinge" axis="0 1 0" range="0 145" />
                    <geom type="capsule" fromto="0 0 0 0 0 -.40" size=".043" mass="3.5" rgba=".29 .35 .47 1" />
                    <body name="pe_esq" pos="0 0 -.40">
                        <joint name="tornozelo_esq_pitch" type="hinge" axis="0 1 0" range="-50 40" />
                        <joint name="tornozelo_esq_roll" type="hinge" axis="1 0 0" range="-30 30" />
                        <geom name="sola_esq" type="box" pos=".045 0 -.045" size=".14 .06 .045" mass="1" rgba=".12 .12 .14 1" contype="2" conaffinity="1" condim="6" friction=".9 .01 .001" solref=".01 1" />
                        <site name="apoio_esq" pos=".045 0 -.09" size=".007" rgba="1 .8 0 1" />
                    </body>
                </body>
            </body>
            <!-- Perna dir: anca 3 eixos, joelho 1, tornozelo 2. Massas aproximadas. -->
            <body name="coxa_dir" pos="0 -0.13 -.05">
                <joint name="anca_dir_yaw" type="hinge" axis="0 0 1" range="-50 50" />
                <joint name="anca_dir_roll" type="hinge" axis="1 0 0" range="-45 45" />
                <joint name="anca_dir_pitch" type="hinge" axis="0 1 0" range="-110 50" />
                <geom type="capsule" fromto="0 0 0 0 0 -.40" size=".06" mass="7" rgba=".23 .28 .40 1" />
                <body name="canela_dir" pos="0 0 -.40">
                    <joint name="joelho_dir" type="hinge" axis="0 1 0" range="0 145" />
                    <geom type="capsule" fromto="0 0 0 0 0 -.40" size=".043" mass="3.5" rgba=".29 .35 .47 1" />
                    <body name="pe_dir" pos="0 0 -.40">
                        <joint name="tornozelo_dir_pitch" type="hinge" axis="0 1 0" range="-50 40" />
                        <joint name="tornozelo_dir_roll" type="hinge" axis="1 0 0" range="-30 30" />
                        <geom name="sola_dir" type="box" pos=".045 0 -.045" size=".14 .06 .045" mass="1" rgba=".12 .12 .14 1" contype="2" conaffinity="1" condim="6" friction=".9 .01 .001" solref=".01 1" />
                        <site name="apoio_dir" pos=".045 0 -.09" size=".007" rgba="1 .8 0 1" />
                    </body>
                </body>
            </body>
            <body name="tronco" pos="0 0 .08">
                <!-- Tronco relativo a bacia: rotacao axial, inclinacao lateral e flexao. -->
                <joint name="tronco_yaw" type="hinge" axis="0 0 1" range="-70 70" />
                <joint name="tronco_roll" type="hinge" axis="1 0 0" range="-35 35" />
                <joint name="tronco_pitch" type="hinge" axis="0 1 0" range="-25 55" />
                <geom type="ellipsoid" pos="0 0 .20" size=".12 .205 .25" mass="25" rgba=".08 .42 .65 1" />
                <geom type="capsule" fromto="0 0 .43 0 0 .50" size=".043" mass=".5" />
                <geom name="cabeca" type="sphere" pos="0 0 .59" size=".095" mass="4.5" />
                <geom name="ombro_visual_esq" type="sphere" pos="0 0.21 .40" size=".063" mass="0" rgba=".08 .42 .65 1" />
                <body name="braco_esq" pos="0 0.23 .40">
                    <!-- Ombro com 3 eixos: nao confundir rotacao axial com a pronacao do antebraco. -->
                    <joint name="ombro_esq_pitch" type="hinge" axis="0 -1 0" range="-70 170" />
                    <joint name="ombro_esq_roll" type="hinge" axis="1 0 0" range="-80 150" />
                    <joint name="ombro_esq_axial" type="hinge" axis="0 0 1" range="-100 100" />
                    <geom type="capsule" fromto="0 0 0 0 0 -.30" size=".043" mass="3" />
                    <body name="cotovelo_body_esq" pos="0 0 -.30">
                        <joint name="cotovelo_esq" type="hinge" axis="0 -1 0" range="0 145" />
                        <geom type="sphere" size=".035" mass=".1" />
                        <body name="antebraco_esq">
                            <joint name="pronacao_esq" type="hinge" axis="0 0 1" range="-100 100" />
                            <geom type="capsule" fromto="0 0 0 0 0 -.27" size=".032" mass="1.4" />
                            <body name="mao_esq" pos="0 0 -.27">
                                <joint name="pulso_esq_flex" type="hinge" axis="0 1 0" range="-80 80" />
                                <joint name="pulso_esq_desvio" type="hinge" axis="1 0 0" range="-40 40" />
                                <geom name="luva_esq" type="box" pos="0 0 -.04" size=".025 .036 .04" mass=".4" rgba=".92 .92 .87 1" />
                                <site name="pega_mao_esq" pos="0 0 -.04" size=".006" rgba="1 .2 .1 1" />
                                <!-- Taco rigidamente ligado a mao esquerda; a mao direita fecha a cadeia por weld. -->
                                <body name="taco" pos="0 0 -.04">
                                    <geom name="punho_taco" type="capsule" fromto="0 0 .035 0 0 -.17" size=".014" mass=".05" rgba=".1 .1 .1 1" />
                                    <geom name="haste_taco" type="capsule" fromto="0 0 -.17 0 0 -1.00" size=".005" mass=".10" rgba=".65 .68 .72 1" contype="4" conaffinity="9" />
                                    <geom name="cabeca_taco" type="box" pos=".025 0 -1.00" size=".055 .027 .022" mass=".20" rgba=".25 .27 .3 1" contype="4" conaffinity="9" solref=".005 1" />
                                    <site name="pega_taco_dir" pos="0 0 -.09" size=".006" rgba=".2 1 .1 1" />
                                    <site name="centro_cabeca_taco" pos=".025 0 -1.00" size=".004" />
                                </body>
                            </body>
                        </body>
                    </body>
                </body>
                <geom name="ombro_visual_dir" type="sphere" pos="0 -0.21 .40" size=".063" mass="0" rgba=".08 .42 .65 1" />
                <body name="braco_dir" pos="0 -0.23 .40">
                    <!-- Ombro com 3 eixos: nao confundir rotacao axial com a pronacao do antebraco. -->
                    <joint name="ombro_dir_pitch" type="hinge" axis="0 -1 0" range="-70 170" />
                    <joint name="ombro_dir_roll" type="hinge" axis="-1 0 0" range="-80 150" />
                    <joint name="ombro_dir_axial" type="hinge" axis="0 0 1" range="-100 100" />
                    <geom type="capsule" fromto="0 0 0 0 0 -.30" size=".043" mass="3" />
                    <body name="cotovelo_body_dir" pos="0 0 -.30">
                        <joint name="cotovelo_dir" type="hinge" axis="0 -1 0" range="0 145" />
                        <geom type="sphere" size=".035" mass=".1" />
                        <body name="antebraco_dir">
                            <joint name="pronacao_dir" type="hinge" axis="0 0 1" range="-100 100" />
                            <geom type="capsule" fromto="0 0 0 0 0 -.27" size=".032" mass="1.4" />
                            <body name="mao_dir" pos="0 0 -.27">
                                <joint name="pulso_dir_flex" type="hinge" axis="0 1 0" range="-80 80" />
                                <joint name="pulso_dir_desvio" type="hinge" axis="1 0 0" range="-40 40" />
                                <geom name="luva_dir" type="box" pos="0 0 -.04" size=".025 .036 .04" mass=".4" rgba=".92 .92 .87 1" />
                                <site name="pega_mao_dir" pos="0 0 -.04" size=".006" rgba="1 .2 .1 1" />
                            </body>
                        </body>
                    </body>
                </body>
            </body>
        </body>
        <!-- Bola livre, sem contacto inicial com o taco. Sem aerodinamica nesta fase. -->
        <body name="bola" pos=".7155 -.095 .02135">
            <freejoint name="bola_livre" />
            <geom name="bola_geom" type="sphere" size=".02135" mass=".0459" rgba=".98 .98 .98 1" contype="8" conaffinity="5" condim="6" friction=".35 .001 .0002" solref=".005 1" />
        </body>
    </worldbody>
    <equality>
        <!-- Pega idealizada sem deslizamento. Impoe posicao e orientacao relativas; nao simula dedos. -->
        <weld name="pega_direita" site1="pega_mao_dir" site2="pega_taco_dir" solref=".015 1" solimp=".95 .99 .001" torquescale=".08" />
    </equality>
    <actuator>
        <!-- Motores de binario, gear=1. Controlador PD e compensacao estatica no Python. -->
        <motor name="motor_anca_esq_yaw" joint="anca_esq_yaw" gear="1" ctrllimited="true" ctrlrange="-150 150" />
        <motor name="motor_anca_esq_roll" joint="anca_esq_roll" gear="1" ctrllimited="true" ctrlrange="-150 150" />
        <motor name="motor_anca_esq_pitch" joint="anca_esq_pitch" gear="1" ctrllimited="true" ctrlrange="-180 180" />
        <motor name="motor_joelho_esq" joint="joelho_esq" gear="1" ctrllimited="true" ctrlrange="-150 150" />
        <motor name="motor_tornozelo_esq_pitch" joint="tornozelo_esq_pitch" gear="1" ctrllimited="true" ctrlrange="-120 120" />
        <motor name="motor_tornozelo_esq_roll" joint="tornozelo_esq_roll" gear="1" ctrllimited="true" ctrlrange="-90 90" />
        <motor name="motor_anca_dir_yaw" joint="anca_dir_yaw" gear="1" ctrllimited="true" ctrlrange="-150 150" />
        <motor name="motor_anca_dir_roll" joint="anca_dir_roll" gear="1" ctrllimited="true" ctrlrange="-150 150" />
        <motor name="motor_anca_dir_pitch" joint="anca_dir_pitch" gear="1" ctrllimited="true" ctrlrange="-180 180" />
        <motor name="motor_joelho_dir" joint="joelho_dir" gear="1" ctrllimited="true" ctrlrange="-150 150" />
        <motor name="motor_tornozelo_dir_pitch" joint="tornozelo_dir_pitch" gear="1" ctrllimited="true" ctrlrange="-120 120" />
        <motor name="motor_tornozelo_dir_roll" joint="tornozelo_dir_roll" gear="1" ctrllimited="true" ctrlrange="-90 90" />
        <motor name="motor_tronco_yaw" joint="tronco_yaw" gear="1" ctrllimited="true" ctrlrange="-120 120" />
        <motor name="motor_tronco_roll" joint="tronco_roll" gear="1" ctrllimited="true" ctrlrange="-120 120" />
        <motor name="motor_tronco_pitch" joint="tronco_pitch" gear="1" ctrllimited="true" ctrlrange="-160 160" />
        <motor name="motor_ombro_esq_pitch" joint="ombro_esq_pitch" gear="1" ctrllimited="true" ctrlrange="-80 80" />
        <motor name="motor_ombro_esq_roll" joint="ombro_esq_roll" gear="1" ctrllimited="true" ctrlrange="-80 80" />
        <motor name="motor_ombro_esq_axial" joint="ombro_esq_axial" gear="1" ctrllimited="true" ctrlrange="-50 50" />
        <motor name="motor_cotovelo_esq" joint="cotovelo_esq" gear="1" ctrllimited="true" ctrlrange="-50 50" />
        <motor name="motor_pronacao_esq" joint="pronacao_esq" gear="1" ctrllimited="true" ctrlrange="-20 20" />
        <motor name="motor_pulso_esq_flex" joint="pulso_esq_flex" gear="1" ctrllimited="true" ctrlrange="-20 20" />
        <motor name="motor_pulso_esq_desvio" joint="pulso_esq_desvio" gear="1" ctrllimited="true" ctrlrange="-20 20" />
        <motor name="motor_ombro_dir_pitch" joint="ombro_dir_pitch" gear="1" ctrllimited="true" ctrlrange="-80 80" />
        <motor name="motor_ombro_dir_roll" joint="ombro_dir_roll" gear="1" ctrllimited="true" ctrlrange="-80 80" />
        <motor name="motor_ombro_dir_axial" joint="ombro_dir_axial" gear="1" ctrllimited="true" ctrlrange="-50 50" />
        <motor name="motor_cotovelo_dir" joint="cotovelo_dir" gear="1" ctrllimited="true" ctrlrange="-50 50" />
        <motor name="motor_pronacao_dir" joint="pronacao_dir" gear="1" ctrllimited="true" ctrlrange="-20 20" />
        <motor name="motor_pulso_dir_flex" joint="pulso_dir_flex" gear="1" ctrllimited="true" ctrlrange="-20 20" />
        <motor name="motor_pulso_dir_desvio" joint="pulso_dir_desvio" gear="1" ctrllimited="true" ctrlrange="-20 20" />
    </actuator>
    <custom>
        <numeric name="kp" data="1500 1500 1500 1500 1200 1200 1500 1500 1500 1500 1200 1200 700 700 900 450 450 250 250 100 100 100 450 450 250 250 100 100 100" />
        <numeric name="kd" data="80 80 80 70 60 60 80 80 80 70 60 60 45 45 55 25 25 15 15 6 6 6 25 25 15 15 6 6 6" />
    </custom>
    <keyframe>
        <key name="preparacao" qpos="-0.05 0 0.9 1 0 0 0 1.06592938965e-18 0.0918220982 -0.3286827892 0.604981490488 -0.276298701287 -0.0918220982 6.39928357764e-18 -0.0918220982 -0.3286827892 0.604981490488 -0.276298701287 0.0918220982 0 0 0.349065850399 0.360001555338 -0.620861366438 0.0459151497378 1.14647702996 -0.358407694393 0.832558391134 0.310278440231 0.726051744609 -0.506042720274 -0.359281764433 0.428164837228 0.381114900346 0.425447649001 -0.351104087394 0.7155 -0.095 0.02135 1 0 0 0" />
    </keyframe>
</mujoco>